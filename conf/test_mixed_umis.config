/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running tests with a mix of random and non-random UMIs
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a test with mixed UMI types.

    Use as follows:
        nextflow run nf-core/fastquorum -profile test_mixed_umis,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name = 'Test mixed UMI profile'
    config_profile_description = 'Test dataset mixing random and non-random UMI samples'

    // Base directory for nf-core/modules test data
    modules_testdata_base_path = 's3://ngi-igenomes/testdata/nf-core/modules/'

    // Input data — samplesheet with some samples having umi_file and some without
    // TODO: update URL once test data is added to nf-core/test-datasets
    input = "https://raw.githubusercontent.com/nf-core/test-datasets/fastquorum/testdata/samplesheets/samplesheet.mixed_umis.csv"

    // Genome references
    fasta = "https://raw.githubusercontent.com/nf-core/test-datasets/fastquorum/references/chr17.fa"
}

validation {
    defaultIgnoreParams = ['genomes', 'modules_testdata_base_path']
}

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '6.h',
    ]
}
